{
  "name": "flowboard",
  "private": true,
  "version": "1.0.0",
  "description": "Flowboard \u2014 the Long Term Internship capstone: a full-stack project and task manager.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "node --watch server/index.ts",
    "dev:full": "node scripts/dev-full.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "NODE_ENV=production node server/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:server": "BASE_PATH=/ VITE_BACKEND=server vite build --outDir dist-server"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/schibsted-grotesk": "^5.3.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.2.1",
    "framer-motion": "^14.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.54.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "supertest": "^7.3.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
